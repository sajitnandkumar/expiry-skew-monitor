# Angel One SmartAPI credentials — see README for how to obtain these.
SMARTAPI_API_KEY=your_api_key_here

# Local single-user mode: fill these three and the app auto-logs-in as you.
# Leave them out (hosted/multi-user mode) and visitors connect their own
# Angel One account via the publisher-login flow instead.
SMARTAPI_CLIENT_CODE=your_client_code_here
SMARTAPI_PIN=your_pin_here
SMARTAPI_TOTP_SECRET=your_totp_secret_here

# Force a mode instead of auto-detecting from the credentials above:
# AUTH_MODE=env | publisher

# Rows where call and put premiums are within this % of each other
# are shown as neutral (no colour).
SKEW_TOLERANCE_PCT=5.0

# Optional server settings
HOST=127.0.0.1
PORT=8000

# Strikes on each side of ATM (5 -> 11 rows total)
STRIKES_EACH_SIDE=5
